# ── 敏感信息（最重要！）─────────────────────────
# 这些东西绝对不能被提交。一旦推上公开仓库，
# 自动化的爬虫几分钟内就会抓到。
config.ini
config.local.*
.env
cookies.txt
*.log
*.key
*.pem

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── C++ ───────────────────────────────────────
*.o
*.obj
*.exe
*.out
*.a
*.so
*.dll
build/
cmake-build-*/

# ── 编辑器 ────────────────────────────────────
.vscode/
.idea/
*.swp

# ── 系统 ──────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
